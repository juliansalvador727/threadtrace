{
  "name": "thread-trace",
  "displayName": "Thread Trace — Agent Blame",
  "description": "Hover a line to see which agent, model and prompt wrote it.",
  "version": "0.1.0",
  "publisher": "JulianSalvador",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliansalvador727/threadtrace.git"
  },
  "bugs": {
    "url": "https://github.com/juliansalvador727/threadtrace/issues"
  },
  "homepage": "https://github.com/juliansalvador727/threadtrace#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai",
    "agent",
    "blame",
    "git blame",
    "attribution",
    "provenance",
    "agent trace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "threadTrace.installHooks",
        "title": "Thread Trace: Install Agent Hooks",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "threadTrace.uninstallHooks",
        "title": "Thread Trace: Uninstall Agent Hooks",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "threadTrace.showThreadForLine",
        "title": "Thread Trace: Show Thread for Line",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "threadTrace.copyPrompt",
        "title": "Thread Trace: Copy Prompt for Line",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "threadTrace.backfill",
        "title": "Thread Trace: Backfill from Transcripts",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "threadTrace.openOnWeb",
        "title": "Thread Trace: Open Thread on claude.ai",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "threadTrace.toggleAnnotation",
        "title": "Thread Trace: Toggle Line Annotation"
      },
      {
        "command": "threadTrace.toggleHeatmap",
        "title": "Thread Trace: Toggle Agent Heatmap"
      },
      {
        "command": "threadTrace.showLegend",
        "title": "Thread Trace: Show Agent Summary for File"
      },
      {
        "command": "threadTrace.exportAgentTrace",
        "title": "Thread Trace: Export Agent Trace",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "configuration": {
      "title": "Thread Trace",
      "properties": {
        "threadTrace.annotation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show who wrote the current line (agent, model and time) at the end of the line."
        },
        "threadTrace.hover.mode": {
          "type": "string",
          "enum": [
            "annotation",
            "anywhere"
          ],
          "enumDescriptions": [
            "Show the attribution card only when hovering the end-of-line annotation.",
            "Also add a one-line attribution to the normal hover of every line."
          ],
          "default": "annotation",
          "description": "Where the attribution appears on hover."
        },
        "threadTrace.blame.detectMoves": {
          "type": "boolean",
          "default": false,
          "description": "Follow lines moved or copied from other files (git blame -M -C). Slower on large files."
        },
        "threadTrace.heatmap.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a colored bar on each agent-written line, one color per model. Dashed: edited by hand since. Dotted: known only from the commit message."
        },
        "threadTrace.capture.prompt": {
          "type": "string",
          "enum": [
            "full",
            "firstLine",
            "none"
          ],
          "enumDescriptions": [
            "Store the whole prompt, after redaction.",
            "Store only the first line of the prompt.",
            "Don't store prompts."
          ],
          "default": "full",
          "scope": "application",
          "description": "How much of each prompt the capture hook stores. Applies to prompts captured from now on, in every project. Written to ~/.thread-trace/config.json, where the hook reads it."
        },
        "threadTrace.capture.redact": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Extra regular expressions to redact from prompts before they are stored, on top of the built-in patterns for keys, tokens and passwords. Written to ~/.thread-trace/config.json, where the hook reads it."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "threadTrace.threads",
          "name": "Agent Threads",
          "contextualTitle": "Thread Trace",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "threadTrace.threads",
        "contents": "No agent threads are recorded for this file.\n[Backfill from Transcripts](command:threadTrace.backfill)\n[Install Agent Hooks](command:threadTrace.installHooks)",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "threadTrace.threads",
        "contents": "Agent threads are not shown in untrusted workspaces.",
        "when": "!isWorkspaceTrusted"
      }
    ]
  },
  "scripts": {
    "watch": "node esbuild.mjs --watch",
    "build": "tsc --noEmit && node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:integration": "npm run build && node esbuild.mjs --integration && node out/test/integration/runTest.js",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
